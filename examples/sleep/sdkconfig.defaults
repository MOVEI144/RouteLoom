# Mirrors firmware/reference_node/sdkconfig.defaults: the SDK's compile-time
# contract is C++17 without exceptions/RTTI and the runtime expects a 1 kHz
# tick. The Owner task stack is the component Kconfig default.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=0
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# PT-4M-v2 (partitions.csv): two OTA slots on every 4 MB board. The
# bootloader rolls back an unconfirmed OTA image. OTA self-check and boot
# confirmation are pending, so this image does not mark a candidate valid.
# eFuse anti-rollback stays off.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../endpoint_cpp/partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# DevRam quick start: identity and PSK from the component Kconfig instead
# of a provisioned BoardConfig (see README).
CONFIG_ROUTELOOM_DEV_KCONFIG_IDENTITY=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ROUTELOOM_SECURITY_MODE_DEV_RAM=y
CONFIG_ROUTELOOM_ROLE_ENDPOINT=y
CONFIG_ROUTELOOM_RESOURCE_PROFILE_ENDPOINT=y
CONFIG_ROUTELOOM_DEEP_SLEEP=y
CONFIG_ROUTELOOM_SLEEP_AFTER_MS=10000
CONFIG_ROUTELOOM_SLEEP_RADIO_BUDGET_MS=40000
CONFIG_ROUTELOOM_SLEEP_DURATION_MS=30000
