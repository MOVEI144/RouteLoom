CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
# Product images build for size: -Os makes the C3 app about 11% smaller and
# frees about 8 KiB of static RAM against -Og. A debug build appends
# CONFIG_COMPILER_OPTIMIZATION_DEBUG=y (the debug_og cells).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=0
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# PT-4M-v2 (partitions.csv): two OTA slots on every 4 MB board. The
# bootloader rolls back an unconfirmed OTA image. OTA self-check and boot
# confirmation are pending, so this image does not mark a candidate valid.
# eFuse anti-rollback stays off.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Relay role and profile (components/routeloom/Kconfig): 8 end sessions,
# no join relay gateway, no USB bridge.
CONFIG_ROUTELOOM_ROLE_RELAY=y
CONFIG_ROUTELOOM_RESOURCE_PROFILE_RELAY=y
# Distribution images use device identity and Site Authority admission.
CONFIG_ROUTELOOM_SECURITY_MODE_MEMBER_EDHOC=y
