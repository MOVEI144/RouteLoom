CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=0
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# PT-4M-v2 (partitions.csv): two OTA slots on every 4 MB board. The
# bootloader rolls back an unconfirmed OTA image; boot confirms the running
# image once the owner and runtime are up. eFuse anti-rollback stays off.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# The owner/crypto pump starts with the P4 §12.2 16 KiB stack budget.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# Relay role and profile (components/routeloom/Kconfig): 8 end sessions,
# no join relay gateway, no USB bridge.
CONFIG_ROUTELOOM_ROLE_RELAY=y
CONFIG_ROUTELOOM_RESOURCE_PROFILE_RELAY=y
