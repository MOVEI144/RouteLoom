# ESP32-C6 experimental gateway: 512 KiB HP SRAM, USB Serial/JTAG console.
# Move Wi-Fi helpers to flash to retain the static SRAM guard.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# Bound on-demand and static Wi-Fi RX/TX buffers for LR250 mesh traffic.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
# Leaf dedup pool (32 entries) to preserve dynamic heap for Wi-Fi and crypto.
CONFIG_ROUTELOOM_DEDUP_PROFILE_LEAF=y
# ESP-NOW-only Wi-Fi: disable A-MPDU aggregation and unused softAP/enterprise features.
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=2
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
