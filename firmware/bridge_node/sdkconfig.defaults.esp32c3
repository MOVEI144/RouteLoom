# The C3 gateway keeps 32 link and 128 end sessions alongside USB queues.
# Move Wi-Fi helpers to flash to retain the 8 KiB static SRAM guard.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# The C3 gateway's large session bank leaves little dynamic heap at boot.
# Keep the four always-allocated RX buffers needed for the bench's LR250
# traffic, and bound the on-demand RX/TX pools.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
# A gateway on C3 must leave enough heap for Wi-Fi, PHY calibration and
# ESP-NOW. The 96-entry relay dedup pool prevented the default DevRam image
# from booting on the bench; 32 entries keep the bounded admission semantics.
CONFIG_ROUTELOOM_DEDUP_PROFILE_LEAF=y
# ESP-NOW-only Wi-Fi: no A-MPDU aggregation (its reorder/BA buffers are
# boot heap), fewer management buffers, no softAP/enterprise/NVS Wi-Fi
# config. Measured on the 2026-09-26 bench (docs/hil/2026-09-26-fix-166-167.md).
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=2
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
