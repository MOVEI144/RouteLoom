# The C5 gateway's owner, session bank, and USB bridge share HP SRAM with
# Wi-Fi code. Keep the full bank and the 8 KiB static guard.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_DEBUG=n
# Reduce the static dedup pool to retain dynamic RF startup headroom.
CONFIG_ROUTELOOM_DEDUP_PROFILE_LEAF=y
