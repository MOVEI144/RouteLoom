CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=0
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# The bridge protocol owns the USB Serial/JTAG port: console output must go
# to UART0 or it would corrupt the COBS+CRC32 byte stream with log text.
# IDF v6 also mirrors to a SECONDARY console which defaults to USB
# Serial/JTAG — that mirror must be disabled explicitly.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# app_main runs the whole serial/bridge/runtime pump loop; the IDF default
# (~3.5 KB) overflows in MeshNode/bridge call depth (observed: stack
# protection fault right after startup).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Custom table: the single-app layout plus the "rlsec" NVS partition for
# per-peer security state (issue #37). See partitions.csv.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
