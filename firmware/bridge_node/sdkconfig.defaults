CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
# Product images build for size: -Os makes the C3 app about 11% smaller and
# frees about 8 KiB of static RAM against -Og. A debug build appends
# CONFIG_COMPILER_OPTIMIZATION_DEBUG=y (the debug_og cells).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=0
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# The bridge protocol owns the USB Serial/JTAG port: console output must go
# to UART0 or it would corrupt the COBS+CRC32 byte stream with log text.
# IDF v6 also mirrors to a SECONDARY console which defaults to USB
# Serial/JTAG — that mirror must be disabled explicitly.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# PT-4M-v2 (partitions.csv): two OTA slots on every 4 MB board. The
# bootloader rolls back an unconfirmed OTA image. OTA self-check and boot
# confirmation are pending, so this image does not mark a candidate valid.
# eFuse anti-rollback stays off.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# USB gateway role (components/routeloom/Kconfig). The resource profile is
# gateway (128 end sessions) here; the C3 defaults select gateway_small.
CONFIG_ROUTELOOM_ROLE_GATEWAY=y
CONFIG_ROUTELOOM_RESOURCE_PROFILE_GATEWAY=y
# Site membership and device credentials are required; quick starts use
# the explicit DevRam profile in examples/standalone_gateway.
CONFIG_ROUTELOOM_SECURITY_MODE_MEMBER_EDHOC=y
