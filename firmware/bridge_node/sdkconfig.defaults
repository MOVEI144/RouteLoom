CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=0
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# The bridge protocol owns the USB Serial/JTAG port: console output must go
# to UART0 or it would corrupt the COBS+CRC32 byte stream with log text.
# IDF v6 also mirrors to a SECONDARY console which defaults to USB
# Serial/JTAG — that mirror must be disabled explicitly.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# app_main runs the owner, crypto, bridge, and mesh pump. P4 §12.2 budgets
# 16 KiB until the on-device stack high-water is measured.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# PT-4M-v2 (partitions.csv): two OTA slots on every 4 MB board. The
# bootloader rolls back an unconfirmed OTA image; boot confirms the running
# image once the owner and runtime are up. eFuse anti-rollback stays off.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
