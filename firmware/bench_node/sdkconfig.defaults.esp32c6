# Same C6 profile as reference_node: small Wi-Fi buffer pools for
# ESP-NOW-only use (no A-MPDU, fewer management buffers, no softAP/
# enterprise/NVS Wi-Fi config) and the leaf dedup profile of a bench
# endpoint (design-devflow.md §5.4).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=2
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ROUTELOOM_DEDUP_PROFILE_LEAF=y
