# Same small-buffer C3 profile as reference_node: on C3 the default 10
# static RX buffers left only about 3.8 KiB after Wi-Fi/PHY/ESP-NOW startup
# on the bench. ESP-NOW-only Wi-Fi: no A-MPDU aggregation (its reorder/BA
# buffers are boot heap), fewer management buffers, no softAP/enterprise/
# NVS Wi-Fi config.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=2
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
# A bench node is a leaf endpoint, not a relay: the leaf dedup profile keeps
# the static headroom the app increment consumes (design-devflow.md §5.4).
CONFIG_ROUTELOOM_DEDUP_PROFILE_LEAF=y
