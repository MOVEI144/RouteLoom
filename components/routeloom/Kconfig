menu "RouteLoom"

    choice ROUTELOOM_DEDUP_PROFILE
        prompt "Dedup capacity profile"
        default ROUTELOOM_DEDUP_PROFILE_RELAY
        help
            Compile-time capacity of the node's duplicate-suppression pool
            (docs/reference/resource-profiles.json dedup_entries). Each record
            is 136 bytes of static RAM inside MeshNode (the budget allows 152).
            Terminal pins may use at most 7/8 of the pool; a relay's transit
            records are held only for the frame's own deadline plus a short
            slack. Static RAM per role: docs/design/sdk-v1/ram-budget.md.

        config ROUTELOOM_DEDUP_PROFILE_LEAF
            bool "leaf-small (32 records)"
        config ROUTELOOM_DEDUP_PROFILE_RELAY
            bool "relay-c3 (96 records)"
        config ROUTELOOM_DEDUP_PROFILE_GATEWAY
            bool "gateway-s3 (256 records)"
    endchoice

    config ROUTELOOM_DEDUP_CAPACITY
        int
        default 32 if ROUTELOOM_DEDUP_PROFILE_LEAF
        default 256 if ROUTELOOM_DEDUP_PROFILE_GATEWAY
        default 96

    choice ROUTELOOM_SECURITY_MODE
        prompt "Security owner profile"
        default ROUTELOOM_SECURITY_MODE_DEV_RAM
        help
            Exclusive session-security profile (G-SEC P4 §8.4). The
            reference, bridge and example entries share one
            EspNowSecurityOwner; the legacy dev-PSK path is compiled out
            of the non-legacy profiles (no fallback branches) and the
            legacy-only options below depend on LegacyFixture. DevRam is
            the development default (RAM-only provider, no NVS
            counter/replay writes); LegacyFixture stays for the
            host-compat suites only — select it explicitly per build.
            MemberEdhoc is the production candidate.

        config ROUTELOOM_SECURITY_MODE_LEGACY_FIXTURE
            bool "legacy-fixture (dev-PSK, host-compat tests only)"
        config ROUTELOOM_SECURITY_MODE_DEV_RAM
            bool "dev-ram (pairwise RAM sessions, no identity claim)"
        config ROUTELOOM_SECURITY_MODE_MEMBER_EDHOC
            bool "member-edhoc (EDHOC membership via the security owner)"
    endchoice

endmenu
