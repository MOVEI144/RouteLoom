{
  "format": "routeloom-provisioning-golden-v1",
  "kind": "nvs-set",
  "name": "nvs-set",
  "comment": "P-A1 manufactured blob set for image-epoch1 + credential: twin committed records, rlboot session 0 (= first boot runs session 1)",
  "entries": [
    {"namespace": "rltrust", "key": "t0", "type": "blob", "slot_bytes": 2048, "data_hex": ""},
    {"namespace": "rltrust", "key": "t1", "type": "blob", "slot_bytes": 2048, "data_hex": ""},
    {"namespace": "rlcred", "key": "d0", "type": "blob", "slot_bytes": 1024, "data_hex": ""},
    {"namespace": "rlcred", "key": "d1", "type": "blob", "slot_bytes": 1024, "data_hex": ""},
    {"namespace": "rlboot", "key": "session", "type": "u32", "value": 0}
  ]
}
