{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:routeloom:api1:request:1",
  "title": "API1 request envelope v1",
  "description": "API1 prefix and newline excluded. Byte/depth/duplicate-key bounds are transport checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "request_id",
    "method"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[ -~]+$"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "params": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "method": {
            "enum": [
              "capabilities.get",
              "capacity.get"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "messages.read"
          }
        }
      },
      "then": {
        "required": [
          "params"
        ],
        "properties": {
          "params": {
            "$ref": "#/$defs/read"
          }
        }
      }
    }
  ],
  "$defs": {
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network"
      ],
      "properties": {
        "network": {
          "type": "string",
          "pattern": "^00000000[0-9a-fA-F]{8}$",
          "not": {
            "const": "0000000000000000"
          }
        },
        "from": {
          "enum": [
            "earliest",
            "latest"
          ]
        },
        "cursor": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "wait_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15000
        }
      },
      "oneOf": [
        {
          "required": [
            "from"
          ],
          "not": {
            "required": [
              "cursor"
            ]
          }
        },
        {
          "required": [
            "cursor"
          ],
          "not": {
            "required": [
              "from"
            ]
          }
        }
      ]
    }
  }
}
