      "wire_chunk": "ver=2 | sub | relay_id u32 | offset u16 | total u16 | gateway_epoch u32 | proxy_epoch u32 | data (18 B header, 110 B grid)",
      "wire_chunk_header_bytes": 18,
      "wire_reply_bytes": 18,
      "epoch_query_bytes": 24,
      "epoch_reply_bytes": 24,
      "relay_book": {"floors": 128, "active": 8, "no_lru_evict": true},
      "usb": {"capability_bit": 9, "inner_schema": 2}
    }
