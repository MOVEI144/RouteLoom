    "relay_protection": "link-protected per hop, never END_PROTECTED; destination is the proxy's gateway only",
    "lane_roles": {
      "DISCOVERING": "joiner: DISCOVER v3 out, OFFER v3 in",
      "AUTHENTICATING": "joiner: up steps out, down steps and RELAY_STATUS in",
      "MEMBER": "proxy: DISCOVER v3 in, OFFER v3 out, up steps in, down steps and RELAY_STATUS out; relay frames to/from its gateway"
    },
