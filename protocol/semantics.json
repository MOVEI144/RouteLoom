  "route_update_payload": {
    "layout": "count u8 + count x route_record",
    "max_records": 7,
    "first_record": "sender self record, metric 0"
  },
  "broadcast_route_update_payload": {
    "status": "codec only; not enabled on mesh or radio",
    "layout": "version u8=1, flags u8=0, count u8=1..5, reserved u8=0, count x (destination u64, generation u32, sequence u16, metric u16, via u64), all big-endian",
    "max_records": 5,
    "first_record": "sender self record, metric 0, via 0",
    "poison_projection": "receiver equal to via sees infinity; all other receivers see metric",
    "authentication": "group tag does not prove pairwise sender binding"
  },
  "route_request_payload": {
    "frame_protection": "link-only, one hop, hop_remaining 1",
    "fields": [
      {"field": "kind", "bytes": 1},
      {"field": "ttl", "bytes": 1},
      {"field": "requester", "bytes": 8},
      {"field": "target", "bytes": 8},
      {"field": "request_id", "bytes": 4},
      {"field": "record", "bytes": 16}
    ],
    "kinds": {"NEIGHBOR": 1, "DISCOVER": 2, "REPLY": 3},
    "ttl_max": 10,
    "neighbor_ttl": 1,
    "record_destination": {"NEIGHBOR": "requester", "DISCOVER": "requester", "REPLY": "target"},
    "record_semantics": "ordinary route advertisement from the sending neighbor: feasibility applies, sender updates FD before a finite record leaves",
    "dedup_key": ["requester", "request_id", "kind"]
  },
  "group_data": {
    "frame_protection": "link per hop + end protection under the group scope (sender = origin, receiver = broadcast node id as the site group domain; the destination group is authenticated by the end AAD)",
    "destination": "group address = group_address_base | group_id; group 0 reserved; group_all maps to the broadcast node id",
    "group_address_base": "0xFFFFFFFFFFFF0000",
    "group_all": 65535,
    "message_sequence": "bit 63 set | group stream number (u32 per source boot session): dedup and ordering are decided on the header",
    "delivery_contract": "RELIABLE",
    "delivery_round": "bits 0-6 round number, bit 7 REFRESH (every relay re-asks every child)",
    "payload_fields": [
      {"field": "flags", "bytes": 1},
      {"field": "application_payload", "bytes": "0..127"}
    ],
    "flags": {"ORDERED": 1, "PRIORITY_MASK": 6, "PRIORITY_SHIFT": 1},
    "application_payload_max": 127,
    "source": "a configured route gateway of the gateway-scoped profile",
    "forwarding": "one MAC-acknowledged unicast copy per gateway-tree child, no HOP_ACCEPT"
  },
  "group_report_payload": {
    "frame_protection": "link-only, one hop (child -> tree parent), hop_remaining 1",
    "fields": [
      {"field": "source", "bytes": 8},
      {"field": "session", "bytes": 4},
      {"field": "sequence", "bytes": 8},
      {"field": "round", "bytes": 1},
      {"field": "flags", "bytes": 1},
      {"field": "delivered", "bytes": 2},
      {"field": "nonmember", "bytes": 2},
      {"field": "missing_total", "bytes": 2},
      {"field": "missing_count", "bytes": 1}
    ],
    "missing_id_bytes": 8,
    "missing_max": 12,
    "flags": {"NOT_CHILD": 1, "TRUNCATED": 2},
    "semantics": "counts cover the sender's whole subtree for that round; NOT_CHILD carries zero counts; TRUNCATED iff missing_total > missing_count"
  },
