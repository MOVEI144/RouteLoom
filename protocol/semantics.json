    "usb": {
      "capability_bit": 8,
      "subcommands": {"JOIN_RELAY_UP": 96, "JOIN_RELAY_DOWN": 97, "JOIN_RELAY_ABORT": 98, "JOIN_RELAY_RESULT": 99}
